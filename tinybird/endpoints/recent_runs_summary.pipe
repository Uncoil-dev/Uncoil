DESCRIPTION >
    Recent uncoil run summaries from raw spans for dashboard fallback and smoke tests.

NODE endpoint
SQL >
    %
    SELECT
      runId,
      projectId,
      if(countIf(spanType = 'error') > 0, 'failed', if(countIf(spanType = 'run_end') > 0, 'completed', 'running')) AS status,
      count() AS spanCount,
      sum(costUsd) AS totalCostUsd,
      min(createdAt) AS startedAt,
      max(createdAt) AS lastSpanAt,
      if(countIf(spanType IN ('error', 'run_end')) > 0, maxIf(createdAt, spanType IN ('error', 'run_end')), NULL) AS finishedAt,
      anyIf(modelId, modelId != '') AS primaryModel
    FROM spans
    WHERE projectId = {{String(project_id, "")}}
      AND createdAt >= now() - INTERVAL {{Int32(days, 30)}} DAY
    GROUP BY projectId, runId
    ORDER BY lastSpanAt DESC
    LIMIT {{Int32(limit_rows, 50)}}
TYPE endpoint
