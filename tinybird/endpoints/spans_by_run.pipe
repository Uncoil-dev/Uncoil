DESCRIPTION >
    Ordered span timeline for a single uncoil agent run.

NODE endpoint
SQL >
    %
    SELECT
      spanId,
      runId,
      projectId,
      spanType,
      input,
      output,
      latencyMs,
      costUsd,
      modelId,
      toolName,
      createdAt
    FROM spans
    WHERE projectId = {{String(project_id, "")}}
      AND runId = {{String(run_id, "")}}
    ORDER BY createdAt ASC, spanId ASC
    LIMIT {{Int32(limit_rows, 500)}}
TYPE endpoint
