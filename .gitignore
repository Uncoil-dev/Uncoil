# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-cloud/
/.next-clean/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch scripts
install_skills.js
scratch/temp.zip
scratch/docx_extract/
scratch/user-test-tracify/node_modules/

# regional operator artifacts: deploy keys, tokens, and filled-in env files.
# docs/regional-cloud-runbook.md describes this directory as ignored; before
# 2026-08-18 it was not, so real credentials here were one `git add .` from
# being committed. Never remove this rule.
scratch/tracify-regional/
*.env
!*.env.example

# local reference documents; do not publish
/Tracify - Docs/

# generated local artifacts and credentials
**/__pycache__/
**/*.pyc
packages/python-sdk/dist/
packages/python-sdk/src/*.egg-info/
packages/python-sdk/src/*/egg-info/
teams-bot/sessions.json
teams-bot/*-out.log
teams-bot/*-err.log

# local Payload development data and uploads
/payload-local.db*
/public/media/

# clerk configuration (can include secrets)
/.clerk/

# graphify generated knowledge graph output
/graphify-out/

# Playwright local test artifacts
artifacts/reference-parity/
/test-results/
/playwright-report/

# Tinybird CLI credentials — contains a live API token. Was tracked until
# 2026-08-18; untracked then so `tb auth` can no longer commit a workspace token.
.tinyb
.preview-account.json
public/preview-login.html
.preview-watch.log
