# Convex + Better Auth
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_UNCOIL_DEPLOYMENT_KIND=marketing
NEXT_PUBLIC_UNCOIL_REGION=eu
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
UNCOIL_REGION=eu
NEXT_PUBLIC_BETTER_AUTH_IDENTIFY_URL=https://kv.better-auth.com/projects/your-project-id
# Playwright E2E: use PLAYWRIGHT_DEPLOYMENT=cloud for the authenticated cloud host;
# set UNCOIL_E2E_AUTH=1 only when a disposable auth-capable Convex deployment is ready.
# Leave PLAYWRIGHT_REUSE_SERVER unset for deterministic runs; set it to 1 only when
# intentionally targeting an already-running local host.
# PLAYWRIGHT_DEPLOYMENT=cloud
# UNCOIL_E2E_AUTH=1
# PLAYWRIGHT_REUSE_SERVER=1
# Browser-agent wedge validation: provide a real authenticated storage state and
# three run IDs produced by browser-agent workflows before enabling this suite.
# UNCOIL_E2E_WEDGE=1
# UNCOIL_E2E_STORAGE_STATE=.auth/wedge.json
# UNCOIL_E2E_PROJECT_ID=your_project_id
# UNCOIL_E2E_RUN_RESEARCH=research_run_id
# UNCOIL_E2E_RUN_TOOL=tool_run_id
# UNCOIL_E2E_RUN_FAILURE=failure_run_id
# Better Auth also trusts the stable staging alias: https://uncoiltech.vercel.app
# Set BETTER_AUTH_SECRET, SITE_URL, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
# GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, BETTER_AUTH_API_KEY, and
# BETTER_AUTH_IDENTIFY_URL
# in the Convex deployment environment, not in this file.
UNCOIL_API_KEY_HASH_SECRET=replace-with-random-32-byte-secret
# AES-256 key (base64) used to encrypt project-scoped third-party integration secrets.
# Keep this stable across deploys; rotating it requires a credential re-encryption migration.
UNCOIL_INTEGRATION_ENCRYPTION_KEY=

# Tinybird
TINYBIRD_TOKEN=p.your_tinybird_token
TINYBIRD_HOST=https://api.tinybird.co

# Redis cache
REDIS_URL=redis://default:password@host:port

# Inngest
INNGEST_EVENT_KEY=test
INNGEST_SIGNING_KEY=signkey-test-...
UNCOIL_INGEST_LIMIT_PER_MINUTE=6000

# Private Convex HTTP action used by the Inngest online evaluator worker
EVALUATION_INTERNAL_SECRET=replace-with-random-secret

# Slack alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Admin section library access (comma-separated Better Auth user IDs).
# Access fails closed on every host when no approved admin is configured.
UNCOIL_LIBRARY_ORG_IDS=org_your_team
UNCOIL_LIBRARY_USER_IDS=user_owner
UNCOIL_ADMIN_USER_IDS=user_owner
UNCOIL_LIBRARY_ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SYNC_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=

# Payload CMS. Local development falls back to payload-local.db when DATABASE_URL is empty.
# Production on Vercel requires a Postgres URL and a long random PAYLOAD_SECRET.
PAYLOAD_SECRET=
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
EMAIL_FROM="Kristoffer from Uncoil <kb@uncoil.dev>"
EMAIL_REPLY_TO=kb@uncoil.dev

# Public site assistant. Keep the internal Uncoil key server-only.
UNCOIL_ASSISTANT_MODEL=gpt-5.6-luna
# Prefer a separate restricted OpenAI project/key for this public assistant.
UNCOIL_ASSISTANT_OPENAI_API_KEY=
UNCOIL_ASSISTANT_REQUESTS_PER_MINUTE=5
UNCOIL_ASSISTANT_REQUESTS_PER_DAY=100
UNCOIL_ASSISTANT_MAX_COMPLETION_TOKENS=300
UNCOIL_INTERNAL_INGEST_URL=
UNCOIL_INTERNAL_API_KEY=
UNCOIL_ASK_AI_API_KEY=
