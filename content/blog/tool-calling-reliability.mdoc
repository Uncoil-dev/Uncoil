{% failure-mode-option label="Hallucinated tool name" symptom="The model calls a tool name that is not in your registry, or invents a parameter the tool never defined." strategy="Fail closed. Do not fuzzy-match to the nearest real tool name. Log it as a possible prompt or tool-list drift signal, and return the list of valid tool names in the error." code="if (!registry.has(toolName)) return { status: 'terminal_error', reason: 'unknown_tool' };" /%}
