    "smoke:beta": "node scripts/beta-smoke.mjs",
    "smoke:platform": "node scripts/platform-smoke.mjs",
    "stripe:create-managed-product": "node scripts/create-managed-payments-product.mjs",
    "content:import-payload": "node scripts/export-payload-to-markdoc.mjs",
    "verify:eu-trace": "node scripts/verify-eu-trace.mjs",
    "dev:marketing": "node scripts/dev-host.mjs marketing",
    "dev:cloud": "node scripts/dev-host.mjs cloud",
    "publish:sdks": "node scripts/publish-sdks.mjs",
    "release:metadata": "node scripts/release-metadata.mjs",
